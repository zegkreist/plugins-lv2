@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .

<urn:zegkreist:lv2:baixo-fuzz>
	a lv2:Plugin , lv2:DistortionPlugin ;
	doap:name "Baixo Fuzz" ;
	doap:license <http://opensource.org/licenses/isc> ;
	rdfs:comment "Fuzz leve e quente estilo doom para baixo, com o grave limpo separado da distorcao." ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:AudioPort , lv2:InputPort ;
		lv2:index 0 ;
		lv2:symbol "in_l" ;
		lv2:name "In L"
	] , [
		a lv2:AudioPort , lv2:InputPort ;
		lv2:index 1 ;
		lv2:symbol "in_r" ;
		lv2:name "In R"
	] , [
		a lv2:AudioPort , lv2:OutputPort ;
		lv2:index 2 ;
		lv2:symbol "out_l" ;
		lv2:name "Out L"
	] , [
		a lv2:AudioPort , lv2:OutputPort ;
		lv2:index 3 ;
		lv2:symbol "out_r" ;
		lv2:name "Out R"
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "fuzz" ;
		lv2:name "Fuzz" ;
		rdfs:comment "Quantidade de saturacao. Baixo = overdrive quente, alto = fuzz cheio." ;
		lv2:default 4.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 10.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "tone" ;
		lv2:name "Tom" ;
		rdfs:comment "Corte dos agudos do fuzz. Mais baixo = mais escuro." ;
		lv2:default 2500.0 ;
		lv2:minimum 600.0 ;
		lv2:maximum 8000.0 ;
		lv2:portProperty pprops:logarithmic ;
		units:unit units:hz
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "mids" ;
		lv2:name "Médios" ;
		rdfs:comment "Realce ou corte em 650 Hz no som do fuzz." ;
		lv2:default 3.0 ;
		lv2:minimum -12.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 7 ;
		lv2:symbol "fuzz_level" ;
		lv2:name "Nível fuzz" ;
		lv2:default 0.0 ;
		lv2:minimum -40.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 8 ;
		lv2:symbol "clean_level" ;
		lv2:name "Grave limpo" ;
		rdfs:comment "Volume do grave original (abaixo da Divisao). No minimo (-40) desliga." ;
		lv2:default 0.0 ;
		lv2:minimum -40.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 9 ;
		lv2:symbol "split" ;
		lv2:name "Divisão" ;
		rdfs:comment "Frequencia que separa o grave limpo (abaixo) do que vai para o fuzz (acima)." ;
		lv2:default 120.0 ;
		lv2:minimum 40.0 ;
		lv2:maximum 500.0 ;
		lv2:portProperty pprops:logarithmic ;
		units:unit units:hz
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 10 ;
		lv2:symbol "volume" ;
		lv2:name "Volume" ;
		lv2:default 0.0 ;
		lv2:minimum -24.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 11 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:designation lv2:latency ;
		lv2:portProperty lv2:reportsLatency , lv2:integer ;
		lv2:minimum 0 ;
		lv2:maximum 64 ;
		units:unit units:frame
	] .
